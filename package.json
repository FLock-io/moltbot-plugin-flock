{
  "name": "@openclawd/flock",
  "version": "0.5.0",
  "type": "module",
  "description": "FLock API Platform provider plugin for OpenClaw (Moltbot/Clawdbot)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FLock-io/openclaw-plugin-flock.git"
  },
  "homepage": "https://github.com/FLock-io/openclaw-plugin-flock#readme",
  "bugs": {
    "url": "https://github.com/FLock-io/openclaw-plugin-flock/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "moltbot",
    "moltbot-plugin",
    "clawdbot",
    "clawdbot-plugin",
    "flock",
    "flock-io",
    "llm",
    "ai",
    "openai-compatible"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build && node scripts/validate-package.cjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "moltbot.plugin.json",
    "clawdbot.plugin.json"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.0"
  },
  "devDependencies": {
    "openclaw": "^2026.5.7",
    "typescript": "^5.6.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "moltbot": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "clawdbot": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
